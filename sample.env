# ---------------------------------------------------------------------------
# Lettria Perseus MCP - sample environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp sample.env .env
#
# The Perseus SDK reads these variables via pydantic-settings. Anything left
# commented-out falls back to the SDK default shown in the comment.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Your Perseus API key (https://docs.perseus.lettria.net/).
PERSEUS_API_KEY=

# --- Optional: Neo4j export -------------------------------------------------
# Used by the `save_graph_to_neo4j` tool.

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# --- Optional: FalkorDB export ----------------------------------------------
# Used by the `save_graph_to_falkordb` tool.

# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_GRAPH_NAME=perseus_graph

# --- Optional: inline-content tools -----------------------------------------
# Maximum UTF-8 size (bytes) accepted by `build_graph_from_text` and
# `upload_ontology_from_text`. Larger payloads should use the path-based
# tools (`build_graph` / `upload_ontology`) or a filesystem MCP server.
# Default: 1 MiB (1048576).

# PERSEUS_INLINE_CONTENT_MAX_BYTES=1048576

# --- Optional: SDK logging --------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.

# LOGLEVEL=INFO
